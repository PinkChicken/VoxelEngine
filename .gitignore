# Godot 4+ specific ignores
.godot/
/android/
*.tmp

# Large reference material — kept local only, not worth tracking in git history
Reference.pdf
Reference_Two.pdf
Reference_Three.pdf

# Python bytecode cache (tools/fluid_prototypes/ and any future Python tooling)
__pycache__/
*.pyc

# Local-only: the Python fluid-prototype bench suite (design/validation tooling
# and its regression tests) — stays on disk for local iteration, not pushed.
tools/fluid_prototypes/python/

# Local-only: CLAUDE.md is project-specific assistant guidance, not meant for
# the remote repo.
CLAUDE.md

# Local-only: design notes / handoff markdown. ARCHITECTURE.md and
# docs/BUG_LOG.md are the single sources of truth and stay tracked.
*.md
!ARCHITECTURE.md
!docs/BUG_LOG.md
# ARCHITECTURE.md is the ONE design doc: the MPM solver design, sparse-grid (S1) design,
# and CA→MPM cutover record are all folded into it. Do not re-add separate tracked design
# docs; update ARCHITECTURE.md instead.

# Local-only: REA ("Reverse Engineer Anything") third-party MCP tool checkout —
# ~58 MB / 4.7k files, MIT, unpacked without a .git. Analysis tooling, not
# project source; must never enter this repo's history.
rea-main/

# Local-only: the 17 MB MLS-MPM reference paper — same rationale as Reference*.pdf.
MPM reference.pdf

# Retired MPM evaluation harness (brief §37.1 deleted it; a copy still sits on
# disk for local probing). The production node is simulations/mpm_simulation.gd.
mpm_test.gd
mpm_test.gd.uid
mpm_test.tscn

# Local-only: the Taichi MPM benches — reference/findings, not code to build on
# (brief §37.1). Mirrors the tools/fluid_prototypes/python/ rule above.
tools/mpm_prototype/
