#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Granular simulation compute shader.
// All active chunks are dispatched in a single call:
//   groups = (active_count * 4, 4, 4)
// gl_WorkGroupID.x encodes: chunk_index * 4 + local_x_workgroup
// Reads world state from voxel_buf_a; appends moved voxels to the changelog.
// On each successful move, atomicOrs dirty_chunks bitmask for both source and
// destination chunk slots so the CPU can derive the active set without iterating
// the full changelog (replaces _extract_changed_chunks).

layout(set = 0, binding = 0, std430) readonly buffer VoxelBufA  { uint data[]; } voxels_a;
layout(set = 0, binding = 1, std430) coherent buffer VoxelBufB  { uint data[]; } voxels_b;
layout(set = 0, binding = 2, std430) readonly buffer ChunkTable { int  data[]; } chunk_table;
layout(set = 0, binding = 3, std430) readonly buffer SimParams {
    int chunk_size;
    int grid_min_x;
    int grid_min_y;
    int grid_min_z;
    int grid_span_x;
    int grid_span_y;
    int grid_span_z;
    int frame;
} params;
layout(set = 0, binding = 4, std430) readonly buffer MaterialSim { uint data[256]; } material_sim;
layout(set = 0, binding = 5, std430)          buffer Changelog {
    uint count;
    uint entries[];   // interleaved: flat_idx, new_value, flat_idx, new_value ...
} changelog;
layout(set = 0, binding = 6, std430) readonly buffer ChunkList {
    int data[];       // [x0, y0, z0,  x1, y1, z1, ...]  — one ivec3 per active chunk
} chunk_list;
// 1 bit per voxel-buffer slot; CPU allocates ceil(capacity/32)*4 bytes, zeroed before dispatch.
layout(set = 0, binding = 7, std430)          buffer DirtyChunks  { uint data[]; } dirty_chunks;
// 1 u32 per voxel slot (same indexing as voxels_a/b): set to 1 when grain moves, zeroed by zero_slots.
layout(set = 0, binding = 8, std430)          buffer SimActiveBuf { uint data[]; } sim_active;

const uint SIM_GRANULAR  = 1u;
const uint SIM_LIQUID    = 2u;
const uint MAX_CHANGELOG = 524288u;  // must match WorldOrchestrator.MAX_CHANGELOG_ENTRIES


// Chunk coordinate for a world position — matches Godot's floor division.
ivec3 world_to_chunk(ivec3 gpos) {
    float cs = float(params.chunk_size);
    return ivec3(floor(float(gpos.x) / cs),
                 floor(float(gpos.y) / cs),
                 floor(float(gpos.z) / cs));
}

// Returns the flat voxel-buffer index for a world position, or -1 if out of range.
int world_to_flat(ivec3 gpos) {
    int cs  = params.chunk_size;
    int vpc = cs * cs * cs;
    ivec3 cp  = world_to_chunk(gpos);
    ivec3 lcp = cp - ivec3(params.grid_min_x, params.grid_min_y, params.grid_min_z);
    if (lcp.x < 0 || lcp.x >= params.grid_span_x ||
        lcp.y < 0 || lcp.y >= params.grid_span_y ||
        lcp.z < 0 || lcp.z >= params.grid_span_z) return -1;
    int tbl  = lcp.z * params.grid_span_x * params.grid_span_y
             + lcp.y * params.grid_span_x
             + lcp.x;
    int slot = chunk_table.data[tbl];
    if (slot < 0) return -1;
    ivec3 lp = gpos - cp * cs;
    return slot * vpc + lp.z * cs * cs + lp.y * cs + lp.x;
}

uint read_a(ivec3 gpos) {
    int idx = world_to_flat(gpos);
    return (idx >= 0) ? voxels_a.data[idx] : 0u;
}

bool is_passable(ivec3 gpos) {
    uint mat = read_a(gpos) & 0xFFu;
    return mat == 0u || material_sim.data[mat] == SIM_LIQUID;
}

void mark_dirty(int flat_idx, int vpc) {
    int chunk_slot = flat_idx / vpc;
    atomicOr(dirty_chunks.data[uint(chunk_slot) >> 5u], 1u << (uint(chunk_slot) & 31u));
}

// Atomically claim destination slot, then log both source→air and dest→my_voxel.
// Returns true if this thread won the destination; false if another grain claimed it first.
// zero_slots.comp zeros all active chunk B slots before each dispatch so 0u == unclaimed.
bool try_move(int df, uint my_voxel, int my_flat, int vpc) {
    uint old = atomicCompSwap(voxels_b.data[df], 0u, my_voxel);
    if (old != 0u) return false;
    uint log_slot = atomicAdd(changelog.count, 2u);
    if (log_slot + 1u < MAX_CHANGELOG) {
        changelog.entries[log_slot * 2u]             = uint(df);
        changelog.entries[log_slot * 2u + 1u]        = my_voxel;
        changelog.entries[(log_slot + 1u) * 2u]      = uint(my_flat);
        changelog.entries[(log_slot + 1u) * 2u + 1u] = 0u;
    }
    voxels_b.data[my_flat] = 0u;
    sim_active.data[my_flat] = 1u;
    mark_dirty(my_flat, vpc);
    mark_dirty(df, vpc);
    return true;
}

// Swap with a liquid voxel: granular material claims water_pos via CAS, and the displaced
// water is relocated in PRIORITY ORDER — sideways at its own height, then sideways one
// level up, only rising directly into my_flat (this thread's own vacated slot) as a last
// resort (gap fix, 2026-07-10: previously only the straight-down fall path tried sideways
// first — the diagonal-fall path always teleported water straight to my_flat with no
// sideways attempt at all; this single function now backs BOTH paths, parameterized by
// water_pos so it works regardless of which direction the granular voxel is falling).
//
// their_voxel is the liquid voxel read from voxels_a — its fill byte travels intact.
// lat[] is the same shuffled lateral-offset array the caller already built for its own
// diagonal-fall search, reused here so sideways relocation isn't axis-biased either.
//
// INVARIANT (do not break without re-deriving safety): the level-3 fallback target is
// ALWAYS my_flat, never a newly-CAS'd cell. my_flat is this thread's own exclusive source
// slot, provably free at this point in the tick, so this function can never fail to find
// SOME destination for the displaced water once it has claimed water_pos. If the fallback
// target were changed to something else that requires its own CAS (e.g. "directly above
// water_pos"), that CAS could lose a race, leaving water_pos claimed for the granular voxel
// with nowhere for its water to go — a silent mass-conservation bug, not a cosmetic one.
bool try_displace_priority(ivec3 water_pos, uint my_voxel, uint their_voxel, int my_flat, int vpc, ivec3 lat[4]) {
    int df = world_to_flat(water_pos);
    if (df < 0) return false;
    uint old = atomicCompSwap(voxels_b.data[df], 0u, my_voxel);
    if (old != 0u) return false;

    ivec3 up = ivec3(0, 1, 0);
    int water_dst = -1;
    // Level 1: sideways at the liquid's own height.
    for (int i = 0; i < 4 && water_dst < 0; i++) {
        ivec3 p = water_pos + lat[i];
        if ((read_a(p) & 0xFFu) == 0u) {
            int sd = world_to_flat(p);
            if (sd >= 0 && atomicCompSwap(voxels_b.data[sd], 0u, their_voxel) == 0u) water_dst = sd;
        }
    }
    // Level 2: sideways one level above the liquid (still not touching my_flat).
    for (int i = 0; i < 4 && water_dst < 0; i++) {
        ivec3 p = water_pos + up + lat[i];
        if ((read_a(p) & 0xFFu) == 0u) {
            int sd = world_to_flat(p);
            if (sd >= 0 && atomicCompSwap(voxels_b.data[sd], 0u, their_voxel) == 0u) water_dst = sd;
        }
    }

    if (water_dst >= 0) {
        // Water went sideways — 3 changelog entries (df->sand, water_dst->water, my_flat->air).
        uint log_slot = atomicAdd(changelog.count, 3u);
        if (log_slot + 2u < MAX_CHANGELOG) {
            changelog.entries[log_slot * 2u]             = uint(df);
            changelog.entries[log_slot * 2u + 1u]        = my_voxel;
            changelog.entries[(log_slot + 1u) * 2u]      = uint(water_dst);
            changelog.entries[(log_slot + 1u) * 2u + 1u] = their_voxel;
            changelog.entries[(log_slot + 2u) * 2u]      = uint(my_flat);
            changelog.entries[(log_slot + 2u) * 2u + 1u] = 0u;
        }
        voxels_b.data[my_flat] = 0u;
        mark_dirty(water_dst, vpc);
    } else {
        // Truly trapped (e.g. a sealed 1-wide shaft) — water rises into my_flat, the one
        // slot guaranteed free (see the INVARIANT note above). Last resort, not the common case.
        uint log_slot = atomicAdd(changelog.count, 2u);
        if (log_slot + 1u < MAX_CHANGELOG) {
            changelog.entries[log_slot * 2u]             = uint(df);
            changelog.entries[log_slot * 2u + 1u]        = my_voxel;
            changelog.entries[(log_slot + 1u) * 2u]      = uint(my_flat);
            changelog.entries[(log_slot + 1u) * 2u + 1u] = their_voxel;
        }
        voxels_b.data[my_flat] = their_voxel;
    }
    sim_active.data[my_flat] = 1u;
    mark_dirty(my_flat, vpc);
    mark_dirty(df, vpc);
    return true;
}

float randf(int seed) {
    uint h = uint(seed);
    h ^= h >> 16u;
    h *= 0x45d9f3bu;
    h ^= h >> 16u;
    return float(h & 0x7FFFFFFFu) / 2147483647.0;
}

void main() {
    int cs = params.chunk_size;
    int vpc = cs * cs * cs;

    // gl_WorkGroupID.x = chunk_idx * 4 + wg_x_local
    int chunk_idx  = int(gl_WorkGroupID.x) / 4;
    int wg_x_local = int(gl_WorkGroupID.x) % 4;

    ivec3 local_pos = ivec3(
        wg_x_local * 8 + int(gl_LocalInvocationID.x),
        int(gl_WorkGroupID.y) * 8 + int(gl_LocalInvocationID.y),
        int(gl_WorkGroupID.z) * 8 + int(gl_LocalInvocationID.z)
    );
    if (any(greaterThanEqual(local_pos, ivec3(cs)))) return;

    ivec3 chunk_pos = ivec3(
        chunk_list.data[chunk_idx * 3],
        chunk_list.data[chunk_idx * 3 + 1],
        chunk_list.data[chunk_idx * 3 + 2]
    );
    ivec3 gpos = chunk_pos * cs + local_pos;

    // Resolve this thread's slot directly.
    ivec3 lcp = chunk_pos - ivec3(params.grid_min_x, params.grid_min_y, params.grid_min_z);
    int tbl   = lcp.z * params.grid_span_x * params.grid_span_y
              + lcp.y * params.grid_span_x
              + lcp.x;
    int my_slot = chunk_table.data[tbl];
    if (my_slot < 0) return;

    int my_local = local_pos.z * cs * cs + local_pos.y * cs + local_pos.x;
    int my_flat  = my_slot * vpc + my_local;

    uint my_voxel = voxels_a.data[my_flat];

    uint mat_id = my_voxel & 0xFFu;
    if (mat_id == 0u || material_sim.data[mat_id] != SIM_GRANULAR) return;

    if ((local_pos.x + local_pos.z) % 2 != params.frame % 2) return;

    // --- Try fall straight down ---
    ivec3 below = gpos + ivec3(0, -1, 0);
    int seed = params.frame * 1013904223 + my_flat;

    // Shuffled lateral offsets — shared by diagonal-fall and water-displacement.
    // Integer hash + % avoids float->int out-of-bounds that biased toward +X.
    ivec3 lat[4];
    lat[0] = ivec3( 1, 0,  0);
    lat[1] = ivec3(-1, 0,  0);
    lat[2] = ivec3( 0, 0,  1);
    lat[3] = ivec3( 0, 0, -1);
    {
        ivec3 t;
        uint sh = uint(seed) ^ 0xdeadbeef;
        sh ^= sh >> 16u; sh *= 0x45d9f3bu; sh ^= sh >> 16u; int r0 = int(sh % 4u);
        sh ^= sh >> 13u; sh *= 0x9e3779b9u; sh ^= sh >> 17u; int r1 = int(sh % 3u);
        sh ^= sh >> 11u; sh *= 0x6c62272eu; sh ^= sh >> 15u; int r2 = int(sh % 2u);
        t = lat[3]; lat[3] = lat[r0]; lat[r0] = t;
        t = lat[2]; lat[2] = lat[r1]; lat[r1] = t;
        t = lat[1]; lat[1] = lat[r2]; lat[r2] = t;
    }
    {
        uint dest     = read_a(below);
        uint dest_mat = dest & 0xFFu;
        if (dest_mat == 0u) {
            int df = world_to_flat(below);
            if (df >= 0 && try_move(df, my_voxel, my_flat, vpc)) return;
        } else if (material_sim.data[dest_mat] == SIM_LIQUID) {
            if (try_displace_priority(below, my_voxel, dest, my_flat, vpc, lat)) return;
        }
    }

    // --- Try diagonal-down (same shuffled order as lateral, no axis bias) ---
    for (int i = 0; i < 4; i++) {
        ivec3 d = below + lat[i];
        uint dest = read_a(d);
        uint dest_mat = dest & 0xFFu;
        if (dest_mat == 0u) {
            int df = world_to_flat(d);
            if (df >= 0 && try_move(df, my_voxel, my_flat, vpc)) return;
        } else if (material_sim.data[dest_mat] == SIM_LIQUID) {
            // GAP FIX (2026-07-10): previously called the raw (non-priority) try_displace
            // here, which always teleported water straight to my_flat with NO sideways
            // attempt — inconsistent with the straight-down path just above, and the most
            // common case in practice (sand's shuffled lateral fall order means diagonal
            // hits at least as often as straight-down). try_displace_priority (see its
            // definition/INVARIANT comment above) now backs both paths identically.
            if (try_displace_priority(d, my_voxel, dest, my_flat, vpc, lat)) return;
        }
    }
}
