#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Pressure-driven horizontal+vertical fluid flux — persistent virtual-pipe model.
//
// Phase 7e Step 4 — Pass A / Accelerate (params.pass == 0): accelerate flux. Every voxel
// (liquid or air — solid never participates) computes its 3 OWNED faces (+X, +Y, +Z — the
// -axis face at any position is just the neighbour's owned face, negated: one value per
// face in the world, one owner, chosen by world position) whenever at least one side of
// that face is liquid: integrate f' = clamp(f*damp + dh*g_dt, -axis_cap, axis_cap), where
// dh is the hydrostatic HEAD difference (see head(), not raw fill — a flat fill diff can't
// see that a deep column pushes harder than a shallow one) and axis_cap is FILL_CAP for
// X/Z but FILL_CAP*gravity_bias for Y — see the inline "FIX" comments for why a SHARED
// clamp ceiling across axes silently defeats gravity_bias the moment more than one
// direction saturates (common — head() adds 255 per full cell, so even a 2-deep column
// saturates a typical g_dt). Letting AIR cells compute their own owned faces too (not just
// liquid cells) is what makes flow symmetric in every direction, including downward — see
// the "FIX (2026-07-02)" comment inline for why the old liquid-only gating made water
// expand only in +X/+Y/+Z and never fall. flux_buf is NOT zeroed between ticks —
// persistence across ticks is what turns pure diffusion into a damped oscillator (waves,
// slosh) instead of monotonic decay to flat. No atomics: each thread writes only its own 3
// owned lanes, never a neighbour's, so there is no race to guard against. UNCHANGED by the
// 2026-07-06 pass-compression below — Accelerate never rewrites flux_buf outside itself,
// so it was never part of the double-scaling problem in the first place.
//
// Phase 7e Step 9 (2026-07-06, "compress 4 passes to 2") — Transport (params.pass == 1)
// now fuses what used to be three separate synced dispatches (Scale-Outflow, Scale-Inflow,
// Transport) into one. The old design rewrote flux_buf lanes twice — once scaled for the
// donor's outflow budget, once more for the receiver's inflow budget — which required a
// careful sign-based proof that no two invocations ever wrote the same lane in the same
// pass (see git history / docs/BUG_LOG.md for that era). The new design never rewrites
// flux_buf at all after Accelerate: instead, `compute_s_out()`/`compute_s_in()` below
// recompute each relevant cell's scale factor as a PURE function of already-synced,
// read-only data (this tick's `flux_buf` + `voxels_a` fill) — a genuinely local
// computation, redone redundantly per neighbour rather than stored anywhere. Because both
// endpoints of a face independently compute the exact same deterministic function of the
// exact same stable inputs, conservation holds exactly with zero shared writes and zero
// races — no proof needed, purity does the job instead. `compute_s_out(X)` only ever reads
// X's own 1-hop neighbourhood (never recurses); `compute_s_in(X)` calls `compute_s_out()`
// on each of X's up-to-6 neighbours, so from Transport's own thread, computing a
// NEIGHBOUR's `s_in` (needed when that neighbour is the receiver of an outflow of mine) is
// a bounded 2-hop lookup — never deeper. Redundant, but every read is of already-synced,
// cache-friendly data; nothing is recomputed across dispatches, only within this one.
//
// Two dispatches total now (Accelerate → Transport), one fewer submit/sync round-trip per
// sub-step than the already-reduced 3-pass predecessor, two fewer than the original
// 4-pass design. One semantic change worth flagging: since flux_buf is never
// clamped-and-rewritten by an intermediate Scale pass anymore, a lane that's persistently
// unservable no longer gets nudged toward zero by that rewrite — it's still bounded every
// tick by Accelerate's own axis_cap clamp (see Pass A above), so it cannot grow unboundedly,
// but it may sit at a stable nonzero raw magnitude indefinitely if the underlying head
// difference driving it never goes away (e.g. a permanently pressurized face into a full
// receiver). That's the physically correct behaviour, not a bug — the old design's
// "Scale-writeback oscillating trap" bug class (docs/BUG_LOG.md) is structurally impossible
// now, since nothing but Accelerate ever writes flux_buf.
//
// Phase 7e Step 6 — Transport (params.pass == 1): fill'(p) = fill(p) − fx(p) − fy(p) −
// fz(p) + fx(p−X) + fy(p−Y) + fz(p−Z), i.e. subtract everything p's own owned faces
// represent and add everything the −axis neighbours' owned faces represent (sign handles
// both outflow/inflow cases uniformly), with every term additionally scaled by
// s_out(donor) * s_in(receiver) per the fused conservation guard above. Writes the standard
// changelog — this shader still never touches _voxel_buf_a directly, same single-writer
// discipline as every other sim. Air receiving net-positive inbound flux materializes as
// liquid (scans neighbours for the donor material).
//
// fluid_sim.comp (legacy vertical CAS) has been deleted (Phase 7e Step 7) — it was
// silently destroying fill via a destructive try_compress "snap low remainder to zero"
// hack left over from before this redesign existed. Y (vertical) flow is now handled
// entirely by this shader's Y-axis flux, the same head-driven mechanism as X/Z.
//
// FluxBuf layout: 3 signed int lanes per voxel, stride 3, interleaved (fx, fy, fz),
// indexed through the sparse page table exactly like Step 2's single-lane predecessor —
// page*vpc*3 + local*3 + axis. A chunk with no page cannot own flux; Pass A simply skips it.
//
// Dispatch: same multi-chunk encoding as granular_sim.comp.
//   groups = (active_count * 4, 4, 4)

layout(set = 0, binding = 0, std430) readonly buffer VoxelBufA { uint data[]; } voxels_a;
layout(set = 0, binding = 1, std430) readonly buffer ChunkTable { int  data[]; } chunk_table;
layout(set = 0, binding = 2, std430) readonly buffer SimParams {
    int chunk_size;
    int grid_min_x; int grid_min_y; int grid_min_z;
    int grid_span_x; int grid_span_y; int grid_span_z;
    int frame;
    // 0 = Accelerate. 1 = Transport (fused conservation guard + apply, writes changelog).
    // Pressure-projection port (2026-07-04, docs/PRESSURE_PROJECTION_PORT_PLAN.md): 2 =
    // build_rhs, 3 = solve_red, 4 = solve_black, 5 = correct (Checkpoints 3-5, all landed).
    // 6 = level_surface (Checkpoint 6, FLAT_PUDDLE_HANDOFF.md section 5b) -- fractional
    // lateral fill exchange on the free surface, bypassing the pressure solve entirely.
    // Fixes the design gap where BuildRHS's divergence is vertical-stacking-only, so a
    // single flat uneven layer has div==0 everywhere and the solve can never move it.
    int pass;
    float damp;  // velocity retained per tick (0–1) — tunable, see FluidSimulation.damp
    float g_dt;  // acceleration per unit of hydrostatic head — tunable, see FluidSimulation.g_dt
    float gravity_bias;   // Y-axis multiplier on the (dh - elevation) term — see FluidSimulation.gravity_bias
    int settle_threshold; // scheduling-only floor for mark_dirty — see FluidSimulation.settle_threshold
    // Pressure-projection port, Checkpoint 2 -- read by build_rhs/solve_red/solve_black/correct.
    float proj_G;
    float proj_STIFF;
    float proj_OMEGA;
    // Checkpoint 6 (surface-leveling pass, params.pass == 6) -- bench defaults 0.20/1.0,
    // see tools/fluid_prototypes/height_level_prototype.py (LEVEL_RATE/LEVEL_MIN).
    float proj_LEVEL_RATE;
    float proj_LEVEL_MIN;
    // Checkpoint 6, superseded (2026-07-06, see BUG_LOG.md): originally
    // proj_LEVEL_SUBMERGED_MIN, a vertical-fill threshold. Replaced by
    // proj_LEVEL_PRESSURE_MIN -- the |P_self - P_neighbour| threshold beyond which a pair
    // is treated as having a real pressure-solve-owned gradient (defer, damping -> 0)
    // rather than the projection's blind spot (act, damping -> 1). See
    // proj_level_pressure_damping()'s header comment for the full reasoning; bench-validated
    // in tools/fluid_prototypes/level_surface_v3.py. Default 2.0 -- roughly an order of
    // magnitude below the smallest genuine column-height gradient measured in the bench
    // (~3.5) and well above the buried-seam blind-spot case's converged residual (~0.3).
    float proj_LEVEL_PRESSURE_MIN;
} params;
layout(set = 0, binding = 3, std430) readonly buffer MaterialSim { uint data[256]; } material_sim;
layout(set = 0, binding = 4, std430)          buffer Changelog {
    uint count;
    uint entries[];
} changelog;
layout(set = 0, binding = 5, std430) readonly buffer ChunkList { int data[]; } chunk_list;
layout(set = 0, binding = 6, std430)          buffer DirtyChunks { uint data[]; } dirty_chunks;
layout(set = 0, binding = 7, std430) coherent buffer FluxBuf { int data[]; } flux_buf;
// Phase 7e Step 2 — sparse flux paging. flux_buf is indexed by PAGE, not by voxel slot.
// This table maps a chunk's grid-flat index (same formula as ChunkTable) to its page
// index, or -1 if the chunk has no page (zero-flux boundary — most chunks never touch
// fluid and pay zero flux storage). CPU-owned mirror of FluidSimulation._flux_chunk_table.
layout(set = 0, binding = 8, std430) readonly buffer FluxPageTable { int data[]; } flux_page_table;
// Automatic conservation check (2026-07-02) — Transport atomicAdds every real
// (new_fill - old_fill) it applies here. Zero after a full Transport dispatch means mass
// conserved exactly across the dispatch range; nonzero is a direct, quantified leak/gain.
// FluidSimulation zeroes this before each Transport dispatch and reads+reports it after.
layout(set = 0, binding = 9, std430) buffer ConservationCheck { int delta; } conservation;
// Location tracker (added 2026-07-02) — the conservation-check fix (stale pages during the
// idle-guard grace period) didn't resolve the observed leak, so this pinpoints WHERE the
// single largest gain each tick is actually happening instead of continuing to guess at
// mechanisms blindly. Plain (non-atomic) write, intentionally not synchronized against
// races between threads — good enough for "which chunk should I go look at", not meant to
// be a perfectly deterministic "the" largest value if several qualify in the same tick.
layout(set = 0, binding = 10, std430) buffer GainTracker { int flat_idx; int amount; } gain_tracker;
// Pressure-projection port (2026-07-04, Checkpoint 2) -- one float32/voxel each, riding
// the exact same page allocation as flux_buf/flux_page_table (see
// FluidSimulation._pressure_buf/_div_buf). Unread/unwritten by any pass until Checkpoints
// 3-5 (build_rhs writes div_buf; solve_red/solve_black write pressure_buf; correct reads
// both). Declared `coherent` like flux_buf since solve_red/solve_black will read a
// neighbour invocation's write within the same dispatch (red-black coloring).
layout(set = 0, binding = 11, std430) coherent buffer PressureBuf { float data[]; } pressure_buf;
layout(set = 0, binding = 12, std430) coherent buffer DivBuf      { float data[]; } div_buf;

const uint SIM_LIQUID    = 2u;
const uint MAX_CHANGELOG = 524288u;  // must match WorldOrchestrator.MAX_CHANGELOG_ENTRIES

ivec3 world_to_chunk(ivec3 gpos) {
    float cs = float(params.chunk_size);
    return ivec3(floor(float(gpos.x) / cs),
                 floor(float(gpos.y) / cs),
                 floor(float(gpos.z) / cs));
}

int world_to_flat(ivec3 gpos) {
    int cs  = params.chunk_size;
    int vpc = cs * cs * cs;
    ivec3 cp  = world_to_chunk(gpos);
    ivec3 lcp = cp - ivec3(params.grid_min_x, params.grid_min_y, params.grid_min_z);
    if (lcp.x < 0 || lcp.x >= params.grid_span_x ||
        lcp.y < 0 || lcp.y >= params.grid_span_y ||
        lcp.z < 0 || lcp.z >= params.grid_span_z) return -1;
    int tbl  = lcp.z * params.grid_span_x * params.grid_span_y
             + lcp.y * params.grid_span_x
             + lcp.x;
    int slot = chunk_table.data[tbl];
    if (slot < 0) return -1;
    ivec3 lp = gpos - cp * cs;
    return slot * vpc + lp.z * cs * cs + lp.y * cs + lp.x;
}

uint read_a(ivec3 gpos) {
    int idx = world_to_flat(gpos);
    return (idx >= 0) ? voxels_a.data[idx] : 0u;
}

// Grid-flat chunk-table index — identical formula to the ChunkTable lookup inline in
// world_to_flat()/main(), factored out so the flux page table can reuse it.
int chunk_table_idx(ivec3 chunk_pos) {
    ivec3 lcp = chunk_pos - ivec3(params.grid_min_x, params.grid_min_y, params.grid_min_z);
    if (lcp.x < 0 || lcp.x >= params.grid_span_x ||
        lcp.y < 0 || lcp.y >= params.grid_span_y ||
        lcp.z < 0 || lcp.z >= params.grid_span_z) return -1;
    return lcp.z * params.grid_span_x * params.grid_span_y
         + lcp.y * params.grid_span_x
         + lcp.x;
}

// Flux lane index for a world position + axis (0=X, 1=Y, 2=Z), resolved through the
// sparse page table — works across chunk boundaries, needed by Scale (Step 5) to read/
// write a neighbour's owned face. Returns -1 if the containing chunk has no flux page
// (zero-flux boundary) — the caller must treat that exactly like "no flux here".
int flux_lane(ivec3 gpos, int axis) {
    int cs  = params.chunk_size;
    int vpc = cs * cs * cs;
    ivec3 cp  = world_to_chunk(gpos);
    int tbl   = chunk_table_idx(cp);
    if (tbl < 0) return -1;
    int page  = flux_page_table.data[tbl];
    if (page < 0) return -1;
    ivec3 lp = gpos - cp * cs;
    int local = lp.z * cs * cs + lp.y * cs + lp.x;
    return page * vpc * 3 + local * 3 + axis;
}

// Each liquid voxel owns its +X (0), +Y (1), +Z (2) face. The -axis face at any position
// is the neighbour's owned face, negated — one storage location per face in the world.
const ivec3 AXIS_DIR[3] = ivec3[3](ivec3(1, 0, 0), ivec3(0, 1, 0), ivec3(0, 0, 1));

void mark_dirty(int flat_idx, int vpc) {
    int chunk_slot = flat_idx / vpc;
    atomicOr(dirty_chunks.data[uint(chunk_slot) >> 5u], 1u << (uint(chunk_slot) & 31u));
}

// Pressure-projection port (2026-07-04, Checkpoint 3 — docs/PRESSURE_PROJECTION_PORT_PLAN.md).
// BuildRHS (params.pass == 2) computes the provisional-gravity-flux divergence into
// div_buf, per tools/fluid_prototypes/utube_projection.py's prov_fy()/solve_pressure().
//
// "Sealed" here means solid material OR entirely outside the loaded voxel grid (no chunk
// loaded there at all) -- NOT a loaded, empty (air) cell, which is an open boundary. This
// is the port plan's non-negotiable #3: solid/off-grid/withheld-page are all Neumann
// (sealed) boundaries for this system, never treated as air. world_to_flat() already
// returns -1 for both "off-grid" and "chunk not loaded" uniformly, which is exactly the
// distinction needed here.
bool proj_is_sealed(ivec3 p) {
    int idx = world_to_flat(p);
    if (idx < 0) return true;
    uint m = voxels_a.data[idx] & 0xFFu;
    return (m != 0u && material_sim.data[m] != SIM_LIQUID);
}

// True iff p is a loaded, in-range voxel holding the SAME liquid material as mat_id --
// mirrors Accelerate's existing "two different liquids never exchange directly" rule
// (the bench only ever has one liquid type, so its is_liquid() check is the same thing).
bool proj_is_liquid_same(ivec3 p, uint mat_id) {
    int idx = world_to_flat(p);
    if (idx < 0) return false;
    return (voxels_a.data[idx] & 0xFFu) == mat_id;
}

// Provisional vertical gravity flux on the +Y face between p and p+Y (up) -- analogous to
// the bench's prov_fy(). Nonzero only when there's same-material liquid directly above p
// (water above wants to fall into p) and neither side is sealed. Scaled by the ABOVE
// cell's fill (its weight), not a flat constant -- this is what injects the fill
// imbalance into the RHS and is what lets a real lateral pressure gradient survive
// between a tall arm and a short one (see the bench's header comment).
float proj_prov_fy(ivec3 p, uint mat_id) {
    ivec3 above = p + AXIS_DIR[1];
    if (proj_is_sealed(p) || proj_is_sealed(above)) return 0.0;
    if (!proj_is_liquid_same(above, mat_id)) return 0.0;
    int idx_above = world_to_flat(above);
    float fill_above = float((voxels_a.data[idx_above] >> 8u) & 0xFFu);
    return -params.proj_G * (fill_above / 255.0);
}

// Phase 7e Step 3 — hydrostatic head.
//
// Two fully-full (fill==255) cells exert different horizontal push if one sits under
// three more full cells and the other doesn't — raw fill can't see that, only depth can.
// No pressure byte is stored (a stored value must be invalidated every time a cell above
// fills, empties, or streams in — a permanent desync surface); instead the column is
// walked on demand, self-correcting every tick from data already in cache.
//
// head(p) = fill(p) + sum of fill for each consecutive FULL (255), same-material liquid
// cell directly above p, stopping at (and including) the first non-full cell in that
// liquid, or stopping at (and excluding) the first non-liquid/different-material cell.
// A partial-fill cell at p is itself the surface — the walk below never needs to look
// upward past it.
const int HEAD_MAX_DEPTH = 24;  // "very deep" beyond this reads identically either way

int head(ivec3 p, uint mat_id) {
    uint v = read_a(p);
    if ((v & 0xFFu) != mat_id) return 0;  // p isn't this liquid — no head contribution
    uint f = (v >> 8u) & 0xFFu;
    int total = int(f);
    if (f < 255u) return total;  // p is the surface — nothing above it can be submerged
    ivec3 above = p;
    for (int i = 0; i < HEAD_MAX_DEPTH; i++) {
        above.y += 1;
        uint av = read_a(above);
        if ((av & 0xFFu) != mat_id) break;      // non-liquid / different liquid: stop, don't add
        uint af = (av >> 8u) & 0xFFu;
        total += int(af);
        if (af < 255u) break;                   // that cell is the surface — include it, then stop
    }
    return total;
}

// Phase 7e — MIN_MATERIALIZE replaced with a read-side deadzone (2026-07-02, Fable 5
// review). The old floor was a write-side veto: the receiving air cell refused to
// materialize a sub-threshold transfer, but the donor's own delta computation always
// subtracted its full outflow regardless — asymmetric, a real leak (measured at ~100% of
// a droplet's mass over a handful of ticks). eff_flux() fixes this by construction: Scale
// and Transport both read every flux lane through this same pure function, so a
// sub-threshold value is invisible to BOTH sides identically — never counted as a donor's
// outflow, never counted as a receiver's inflow. The raw stored value is left completely
// untouched (never zeroed, never written by this function).
//
// BUG (found 2026-07-02, gravity-fall testing): the "accumulates until it naturally
// crosses the threshold" claim above is WRONG for any cell whose fill has dropped below
// MIN_FLOW, and it's a hard structural trap, not a slow drain. Sequence within one tick:
// Pass A integrates the raw value past the threshold in 1-2 ticks (confirmed: with
// gravity_force alone, tick 1 lands around -10, tick 2 around -20, already past a
// threshold of 16). But Scale runs BEFORE Transport in the same tick, and Scale caps a
// cell's total outflow at my_fill — for a cell with fill=8, Scale re-scales that -20 back
// down to at most -8 and WRITES it back to flux_buf, every single tick, before Transport
// ever gets a turn. Transport then reads eff_flux(-8) = 0 (8 < 16) and moves nothing. Next
// tick, Pass A integrates from that already-shrunk -8, grows past -16 again, Scale caps it
// back down to -8 again — an oscillating trap, not a threshold that eventually gets
// crossed. Reported symptom: voxels sitting at fill 1-14, adjacent to more water below,
// simply never falling no matter how long they're left alone. Every reported value was
// under the old threshold of 16 — not a coincidence.
//
// Fix: lower MIN_FLOW to 1 (any nonzero flux passes). This does NOT reintroduce the
// asymmetric MIN_MATERIALIZE leak fixed earlier — that leak came from donor and receiver
// disagreeing about a value, not from the threshold being small. eff_flux() being applied
// identically on both sides means a low threshold is still leak-free; the only thing a low
// threshold gives up is the cosmetic "don't spawn dust-speck droplets" protection, which
// matters much less now that gravity_bias/gravity_force actively consolidate thin films
// instead of letting them spread indefinitely (the scenario MIN_FLOW=16 was originally
// sized to prevent).
const int MIN_FLOW = 1;

int eff_flux(int raw) {
    return (abs(raw) >= MIN_FLOW) ? raw : 0;
}

// Phase 7e Step 9 (2026-07-06) — pure, ephemeral conservation-scale helpers. Neither of
// these ever writes anything; both are read-only functions of this tick's already-synced
// flux_buf + voxels_a, callable for ANY cell (not just "my own"), which is what lets
// Transport recompute a neighbour's scale factor inline instead of reading it from a
// buffer some other pass wrote. See the file-header comment for why this is race-free.

// Resolves (page, local) for an arbitrary world position — same lookup flux_lane() does
// internally, factored out so compute_s_out/compute_s_in can get both pieces at once
// without re-deriving them per axis.
ivec2 resolve_page_local(ivec3 gpos, int cs, int vpc) {
    int tbl = chunk_table_idx(world_to_chunk(gpos));
    if (tbl < 0) return ivec2(-1, -1);
    int page = flux_page_table.data[tbl];
    if (page < 0) return ivec2(-1, -1);
    ivec3 lp = gpos - world_to_chunk(gpos) * cs;
    int local = lp.z * cs * cs + lp.y * cs + lp.x;
    return ivec2(page, local);
}

// Pressure-projection port (2026-07-04, Checkpoint 4). Classifies a solve neighbour for
// the red-black GS stencil. Uses resolve_page_local (not just world_to_flat) so a
// neighbour whose chunk has a page but is WITHHELD this tick (outside the 1-hop dispatch
// radius, flux_page_table entry temporarily -1) is treated as sealed too -- the exact
// same discipline as compute_s_out/compute_s_in's page<0 fix above, and the port plan's
// non-negotiable #3 (solid / off-grid / withheld page are ALL Neumann-sealed, never air).
const int PROJ_NB_LIQUID = 0;  // same-material liquid: couples normally
const int PROJ_NB_AIR    = 1;  // loaded, in-range, empty: free surface, Dirichlet P=0
const int PROJ_NB_SEALED = 2;  // solid, off-grid, different liquid, or withheld page: dropped

int proj_classify_neighbor(ivec3 p, uint mat_id, int cs, int vpc) {
    ivec2 pl = resolve_page_local(p, cs, vpc);
    if (pl.x < 0) return PROJ_NB_SEALED;
    int idx = world_to_flat(p);
    if (idx < 0) return PROJ_NB_SEALED;  // defensive: page existing implies this shouldn't happen
    uint m = voxels_a.data[idx] & 0xFFu;
    if (m == mat_id) return PROJ_NB_LIQUID;
    if (m == 0u) return PROJ_NB_AIR;
    return PROJ_NB_SEALED;  // solid, or a DIFFERENT liquid -- never couple directly (Accelerate's rule)
}

// Reads pressure_buf at an arbitrary world position through the same paging as flux_buf.
// 0.0 for a withheld/unmapped page -- callers only use this after already confirming
// PROJ_NB_LIQUID via proj_classify_neighbor, so this is never asked to stand in for a
// sealed or free-surface neighbour (those are handled directly in the solve loop).
float proj_pressure_at(ivec3 p, int cs, int vpc) {
    ivec2 pl = resolve_page_local(p, cs, vpc);
    if (pl.x < 0) return 0.0;
    return pressure_buf.data[pl.x * vpc + pl.y];
}

// Checkpoint 6 (surface-leveling pass, docs/PRESSURE_PROJECTION_PORT_PLAN.md /
// FLAT_PUDDLE_HANDOFF.md section 5b). Classifies a LATERAL exchange partner. Reuses the
// same "withheld page = sealed" discipline as proj_classify_neighbor above -- the exchange
// amount is computed independently and identically at BOTH endpoints from this tick's
// read-only pre-pass state (same trick Transport's compute_s_out/compute_s_in already rely
// on), so if the neighbour's chunk isn't part of this tick's dispatch, its own invocation
// never runs and its half of the exchange would never be applied -- a one-sided leak
// exactly like the flux dispatch-range bug documented on Accelerate above. Treating a
// withheld neighbour as NONE (no exchange) rather than guessing keeps this race-free.
const int LEVEL_NB_SURFACE = 0;  // liquid, same material as the asking cell, no same-liquid directly above
const int LEVEL_NB_DRY     = 1;  // air, sitting directly on a sealed floor (a real shelf water can spread onto)
const int LEVEL_NB_NONE    = 2;  // sealed, withheld, submerged, or a different liquid: no exchange

// BUG (found 2026-07-06, in-engine test): the original version of this function took the
// ASKING cell's own mat_id and required the neighbour to match it exactly ("m == mat_id")
// to be classified as LEVEL_NB_SURFACE. That works fine when a liquid surface cell asks
// about a neighbour (mat_id is real, e.g. 3) -- but a DRY cell's own mat_id is 0 (air), so
// a dry cell asking about a genuinely liquid neighbour got "3 == 0" -> false -> NONE,
// meaning the dry cell could never see a surface partner to receive from at all. Result: the
// liquid cell's own delta correctly computed a loss and applied it, but its dry neighbour's
// independently-computed delta was always 0 -- a real one-sided leak (confirmed in-engine:
// a lone droplet on open ground lost its entire fill over several ticks with ZERO
// materialization anywhere nearby). Fix: classify by what is actually there (any liquid
// material counts as a candidate SURFACE), and report which material via nb_mat_out so the
// caller can apply the "don't mix two different liquids" guard itself -- but ONLY when the
// caller is itself a liquid surface cell (a DRY caller has no material of its own yet, so it
// accepts whichever single liquid it finds, mirroring Transport's existing donor-scan rule).
// BUG (found 2026-07-06, in-engine test, after the SUBMERGED_MIN fix above): the boolean
// "is submerged" gate re-evaluates fresh every tick against whatever fill happens to be
// directly above right now. When that fill hovers right at the SUBMERGED_MIN boundary (the
// real-world case: a falling stream's settle noise, e.g. the vertical solve's fy alternating
// -6,-5,-6,-5... tick to tick), the gate flips SURFACE<->NONE on effectively every single
// tick (confirmed in the bench: 199/200 ticks flipped) -- a 100% on/off swing of this cell's
// entire lateral contribution, which is what produced the visible air<->liquid flicker at
// the puddle edge under a landing stream. Fixed via a continuous damping factor -- but that
// fix (like SUBMERGED_MIN before it) still asked "how much fill is directly above me" as a
// PROXY for "does the pressure solve already own this cell's redistribution." That proxy is
// wrong whenever a low-fill seam is buried inside an otherwise-uniformly-stacked blob:
// confirmed in-engine, a fully-submerged 255-fill cell with genuinely open ~11-fill lateral
// neighbours never transferred to them AT ALL, because vertical fill above it alone was
// enough to zero its damping and disable LevelSurface for that cell entirely, regardless of
// whether its lateral neighbours had real room.
//
// BUG (found 2026-07-06, in-engine test): fixed by asking the ACTUAL question instead of a
// proxy for it -- BuildRHS/solve_red/solve_black already compute a real solved pressure
// field every tick (pressure_buf). If there's a genuine pressure difference between two
// neighbours, Correct is already pushing between them and LevelSurface should defer; if the
// difference is ~0 (even when both cells are deeply submerged by fill), the projection has
// no signal there at all -- the actual blind spot. Bench-confirmed (tools/fluid_prototypes/
// level_surface_v3.py): every previously-validated scenario (flat uneven puddle, droplet,
// thin film) has BuildRHS's divergence at or near zero everywhere, so solved P is uniformly
// ~0 there too -- |P_self - P_neighbour| ~ 0 reduces this formula to full strength
// automatically, identical to the old behaviour in all of those cases. Only the
// buried-seam / genuinely-different-column-height cases differ, and in the right direction:
// a real column-height difference (U-tube pre-settle) has a real |ΔP| and correctly defers;
// a same-total-stacking buried seam has near-zero |ΔP| despite very different raw fill,
// correctly letting LevelSurface act where BuildRHS structurally cannot see anything.
//
// This is a PER-PAIR quantity now (not a single per-cell value) -- p_self is fixed per cell,
// but p_nb varies per neighbour, so a cell can correctly have a real gradient toward one
// neighbour (defer) and none toward another (act), unlike the old single self_damping value
// that vetoed ALL of a cell's neighbours at once. proj_pressure_at() already returns 0.0 for
// any non-liquid/withheld position (the same free-surface Dirichlet convention BuildRHS/
// Correct already use), so a dry or sealed neighbour naturally reads as P=0 here too --
// no separate helper needed for that case.
float proj_level_pressure_damping(float p_self, float p_nb) {
    return clamp(1.0 - abs(p_self - p_nb) / params.proj_LEVEL_PRESSURE_MIN, 0.0, 1.0);
}

// Classifies a lateral neighbour by what is actually there (see the classify-symmetry bug
// entry above for why this never gates on the ASKING cell's own material). No longer gates
// on submerged-ness either -- that's now a continuous per-pair damping factor applied by the
// caller (proj_level_pressure_damping), computed independently by both endpoints of a pair
// from the same solved pressure field so conservation stays exact.
int proj_level_classify(ivec3 p, int cs, int vpc, out uint nb_mat_out) {
    nb_mat_out = 0u;
    ivec2 pl = resolve_page_local(p, cs, vpc);
    if (pl.x < 0) return LEVEL_NB_NONE;
    int idx = world_to_flat(p);
    if (idx < 0) return LEVEL_NB_NONE;
    uint m = voxels_a.data[idx] & 0xFFu;
    if (m != 0u && material_sim.data[m] == SIM_LIQUID) {
        nb_mat_out = m;
        return LEVEL_NB_SURFACE;
    }
    if (m == 0u) {
        return proj_is_sealed(p - AXIS_DIR[1]) ? LEVEL_NB_DRY : LEVEL_NB_NONE;
    }
    return LEVEL_NB_NONE;  // solid -- never couple directly
}

// Fill of a neighbour already classified LEVEL_NB_SURFACE (0.0 for anything else, including
// LEVEL_NB_DRY -- an empty cell contributes elevation 0, matching the bench's "treat an
// empty floor cell as elevation y (fill 0)").
float proj_level_fill_of(ivec3 p, int cls) {
    if (cls != LEVEL_NB_SURFACE) return 0.0;
    int idx = world_to_flat(p);
    return float((voxels_a.data[idx] >> 8u) & 0xFFu);
}

// s_out(X) = min(1, fill(X) / total_out(X)), where total_out(X) is exactly what the old
// Scale-Outflow pass computed: X's own 3 owned faces (if positive = outflow from X) plus
// X's 3 neighbour-owned faces at X's negative axes (if negative = outflow from X through a
// face X doesn't own). Purely 1-hop — never looks past X's immediate neighbours.
float compute_s_out(ivec3 gpos, int cs, int vpc) {
    ivec2 pl = resolve_page_local(gpos, cs, vpc);
    int page = pl.x, local = pl.y;
    // page < 0 means "not in THIS TICK's dispatch range" -- which includes chunks that
    // genuinely hold real flux/fill from prior ticks but got temporarily unmapped because
    // they're outside the 1-hop flux_list radius (see _build_flux_chunk_list). Returning
    // 1.0 here ("assume full capacity") let a caller credit/debit fill against a cell that
    // will never actually be dispatched to apply the matching side of the transfer this
    // tick -- a real, silent mass leak (found while testing Build B, see docs/BUG_LOG.md,
    // but structurally present here too since compute_s_out/compute_s_in can reach 2 hops
    // from the dispatching thread while the dispatch range is only 1-hop wide). 0.0 =
    // "unknown, assume no capacity, don't transport" -- stalls one tick at the boundary
    // and self-heals once the frontier expands, same as the page-allocation fix above.
    if (page < 0) return 0.0;

    uint v = read_a(gpos);
    uint fill = (v >> 8u) & 0xFFu;

    int total_out = 0;
    for (int axis = 0; axis < 3; axis++) {
        int lane = page * vpc * 3 + local * 3 + axis;
        int f = eff_flux(flux_buf.data[lane]);
        if (f > 0) total_out += f;

        ivec3 nb = gpos - AXIS_DIR[axis];
        int nlane = flux_lane(nb, axis);
        if (nlane >= 0) {
            int nf = eff_flux(flux_buf.data[nlane]);
            if (nf < 0) total_out += -nf;
        }
    }
    if (total_out == 0) return 1.0;
    return min(1.0, float(fill) / float(total_out));
}

// s_in(X) = min(1, (255-fill(X)) / total_in_scaled(X)), where total_in_scaled sums each
// inflow-to-X face already reduced by THAT face's donor's s_out — exactly what the old
// Scale-Inflow pass computed, except the donor's s_out is recomputed here inline (a 1-hop
// lookup from X, i.e. at most 2 hops from whichever Transport thread called this) instead
// of being read back from a buffer a prior pass wrote.
float compute_s_in(ivec3 gpos, int cs, int vpc) {
    ivec2 pl = resolve_page_local(gpos, cs, vpc);
    int page = pl.x, local = pl.y;
    // See compute_s_out's identical page<0 case above -- same leak, same fix.
    if (page < 0) return 0.0;

    uint v = read_a(gpos);
    uint fill = (v >> 8u) & 0xFFu;

    float total_in = 0.0;
    for (int axis = 0; axis < 3; axis++) {
        // Owned lane negative = inflow to X from X's +axis neighbour (that neighbour is donor).
        int lane = page * vpc * 3 + local * 3 + axis;
        int f = eff_flux(flux_buf.data[lane]);
        if (f < 0) {
            ivec3 donor = gpos + AXIS_DIR[axis];
            total_in += float(-f) * compute_s_out(donor, cs, vpc);
        }

        // Neighbour-owned lane (at X's -axis) positive = inflow to X from that neighbour (donor).
        ivec3 nb = gpos - AXIS_DIR[axis];
        int nlane = flux_lane(nb, axis);
        if (nlane >= 0) {
            int nf = eff_flux(flux_buf.data[nlane]);
            if (nf > 0) {
                total_in += float(nf) * compute_s_out(nb, cs, vpc);
            }
        }
    }
    if (total_in <= 0.0) return 1.0;
    int capacity = 255 - int(fill);
    if (capacity < 0) capacity = 0;
    return min(1.0, float(capacity) / total_in);
}

void main() {
    int cs  = params.chunk_size;
    int vpc = cs * cs * cs;

    int chunk_idx  = int(gl_WorkGroupID.x) / 4;
    int wg_x_local = int(gl_WorkGroupID.x) % 4;

    ivec3 local_pos = ivec3(
        wg_x_local * 8 + int(gl_LocalInvocationID.x),
        int(gl_WorkGroupID.y) * 8 + int(gl_LocalInvocationID.y),
        int(gl_WorkGroupID.z) * 8 + int(gl_LocalInvocationID.z)
    );
    if (any(greaterThanEqual(local_pos, ivec3(cs)))) return;

    ivec3 chunk_pos = ivec3(
        chunk_list.data[chunk_idx * 3],
        chunk_list.data[chunk_idx * 3 + 1],
        chunk_list.data[chunk_idx * 3 + 2]
    );
    ivec3 gpos = chunk_pos * cs + local_pos;

    int tbl     = chunk_table_idx(chunk_pos);
    int my_slot = (tbl >= 0) ? chunk_table.data[tbl] : -1;
    if (my_slot < 0) return;

    int my_local = local_pos.z * cs * cs + local_pos.y * cs + local_pos.x;
    int my_flat  = my_slot * vpc + my_local;  // voxel indexing — voxels_a / changelog / dirty bitmask

    // Flux indexing is per-axis now (Phase 7e Step 4 — 3 owned lanes per voxel, stride 3).
    // -1 means this chunk has no flux page: a valid state (zero-flux boundary), not an error.
    int my_page = (tbl >= 0) ? flux_page_table.data[tbl] : -1;

    uint my_voxel = voxels_a.data[my_flat];
    uint mat_id   = my_voxel & 0xFFu;
    uint my_fill  = (my_voxel >> 8u) & 0xFFu;

    const int FILL_CAP = 255;  // one flux tick can move at most one full voxel's worth of fill

    // === Pass A: accelerate flux (params.pass == 0) ===
    //
    // FIX (2026-07-02): a voxel only ever computed accel for its OWN 3 owned (+X/+Y/+Z)
    // faces, and only when IT was liquid. That's exactly half the physics: for water at p
    // to flow into its -X neighbour q, it's q's owned +X face (the shared face) that needs
    // a negative value — and q owns that face, not p. If q is air, the old code zeroed q's
    // lanes and returned before ever computing it. Net effect: water could only ever push
    // outward from a liquid cell into its +X/+Y/+Z neighbours — never -X/-Y/-Z, and
    // critically never fall (gravity is -Y). Confirmed by report: a placed sphere expanded
    // only up/right/forward, floating in place, never down or backward/left.
    //
    // Fix: gate per-axis, symmetrically, on whether EITHER side of the face is liquid —
    // not on whether the current thread's own voxel is liquid. A solid cell never
    // participates (zeroed, no flow ever possible there); two different liquids never
    // exchange directly (kept separate, same as before); air adjacent to liquid now
    // computes its own owned face exactly like a liquid cell would, using the SAME head()
    // formula for every axis including Y — so gravity isn't a special case or a constant
    // force, it falls out naturally (a liquid cell has head > 0, empty air below always
    // reads head 0, so dh is always negative = pulls down, proportional to actual pressure).
    if (params.pass == 0) {
        if (my_page < 0) return;  // nowhere to store flux for this chunk at all

        bool my_is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        bool my_is_air    = (mat_id == 0u);

        for (int axis = 0; axis < 3; axis++) {
            ivec3 nb = gpos + AXIS_DIR[axis];
            uint nv  = read_a(nb);
            uint nm  = nv & 0xFFu;

            int lane = my_page * vpc * 3 + my_local * 3 + axis;

            bool nb_is_liquid = (nm != 0u && material_sim.data[nm] == SIM_LIQUID);
            bool nb_is_air    = (nm == 0u);

            // BUG (found 2026-07-02, GainTracker location data): reading a neighbour's
            // real voxel data via read_a() above always succeeds regardless of paging or
            // dispatch status — but if the neighbour's CHUNK isn't part of THIS TICK's
            // dispatch range (flux_list), no invocation ever runs for its voxels this
            // tick, so it can never process the debit/credit side of any transfer we
            // compute here. Without this check, a dispatched boundary voxel materializes
            // or drains fill against an un-dispatched neighbour with zero corresponding
            // effect on the other side — a real, unbounded, one-sided leak. Symptom
            // matched exactly: GainTracker showed every large gain sitting at local
            // Y=30/31, the very edge of the paged/dispatched region, growing without
            // bound because each phantom materialization creates a new active voxel,
            // which pulls the dispatch frontier one ring further out next tick, repeating
            // forever. Independent of gravity_force (confirmed: leak persisted with
            // gravity_force=0) — this is a dispatch-range bug, not a gravity bug.
            // flux_page_table is rebuilt every tick by FluidSimulation.step() to reflect
            // current dispatch membership (not just "chunk has ever had a page
            // allocated"), specifically so this check is meaningful on a per-tick basis.
            int nb_cp_tbl = chunk_table_idx(world_to_chunk(nb));
            int nb_page   = (nb_cp_tbl >= 0) ? flux_page_table.data[nb_cp_tbl] : -1;
            if (nb_page < 0) {
                flux_buf.data[lane] = 0;
                continue;
            }

            // Solid on either side of this face: no flow is possible here, ever, until
            // that changes. Also covers "I died since last tick" (I'm now air/solid) and
            // "my neighbour changed" — both self-heal automatically every tick since this
            // reads current state, no separate invalidation branch needed (Step 6b).
            if ((!my_is_liquid && !my_is_air) || (!nb_is_liquid && !nb_is_air)) {
                flux_buf.data[lane] = 0;
                continue;
            }
            // Both air: nothing to move.
            if (!my_is_liquid && !nb_is_liquid) {
                flux_buf.data[lane] = 0;
                continue;
            }
            // Two different liquids: never exchange pressure directly through this face —
            // keeps them separated at a shared boundary with no explicit "don't mix" logic.
            if (my_is_liquid && nb_is_liquid && mat_id != nm) {
                flux_buf.data[lane] = 0;
                continue;
            }

            // Exactly one side holds a liquid (or both hold the same one) — active_mat is
            // whichever material is actually present, so head() reads the right column
            // regardless of which side of the face this thread's voxel is on.
            uint active_mat = my_is_liquid ? mat_id : nm;

            // Hydrostatic head, not raw fill — a flat fill difference can't tell a deep
            // column from a shallow one (see head()). Air always reads as head 0. A liquid
            // cell has head > 0, empty air below always reads head 0, so dh is always
            // negative (pulls down) proportional to actual pressure — this alone already
            // makes gravity fall out of the same formula used for X/Z, no special case
            // needed for basic correctness.
            //
            // FIX (2026-07-02, gravity dominance): pure pressure-difference flow is NOT
            // enough to make an unsupported mass fall coherently instead of spreading —
            // head() is a single scalar per cell reused identically for all 3 axes, so a
            // high-head boundary cell (e.g. the bottom pole of a floating sphere, where
            // horizontal cross-section is also thin and thus also exposed to air) pushes
            // with EQUAL strength in every exposed direction at once, producing an
            // octahedral bulge instead of a coherent fall. gravity_bias multiplies the
            // pressure term on Y only, so once ANY pressure differential exists, vertical
            // response wins the race against lateral spreading for the same dh.
            //
            // FIX (root cause found 2026-07-03 via Fable 5 deep-dive + an exact
            // integer-arithmetic Python emulation of all 4 passes; applied 2026-07-04 —
            // full mechanism in docs/BUG_LOG.md "ROOT CAUSE FOUND (2026-07-03)"): an
            // earlier version of this line added a flat constant, gravity_force,
            // subtracted from accel regardless of dh — meant to give a near-zero-dh
            // floating mass a baseline pull. That constant broke hydrostatic
            // equilibrium: head() is PRESSURE head only, so two vertically stacked
            // at-rest full cells always compute head(B)-head(A) = 255 exactly, never 0.
            // A flat constant only cancels that residual by coincidence of tuning — at
            // this file's original defaults it didn't, so "rest" was never actually a
            // fixed point: every interior vertical face requested the same nonzero
            // forcing every tick forever (Scale-Inflow silently clamped it back to 0 at
            // interior faces, so the bulk looked quiet while spring-loaded), and the
            // surface discharged it as a genuine undamped standing oscillation, because
            // head()'s value jumps discontinuously the instant a full cell drops below
            // 255 (stops reading as "still submerged", becomes "the surface"), flipping
            // the force's sign every half-cycle.
            //
            // Fix: use elevation/piezometric head instead (h = z + p/ρg in classical
            // hydraulics) — one cell of elevation is worth exactly FILL_CAP (255) in
            // fill units, so the Y-axis total head difference is (pressure head) minus
            // (elevation), not pressure head alone. For a settled column this is
            // 255 - 255 = 0 exactly: rest is now a genuine fixed point at any
            // g_dt/gravity_bias, no tuning required. gravity_force's original purpose
            // (pull a near-zero-dh floating mass down) falls out of this for free: a
            // floating blob's bottom face sees dh_total = 0 - 255, strongly negative,
            // so it still falls coherently with no separate constant needed.
            int dh = head(gpos, active_mat) - head(nb, active_mat);

            float accel = (axis == 1)
                ? (float(dh) - float(FILL_CAP)) * params.g_dt * params.gravity_bias
                : float(dh) * params.g_dt;

            // FIX (2026-07-02, follow-up to the freezing-columns bug above): narrowing the
            // g_dt/gravity_bias export ranges was NOT enough. head() adds 255 per full cell
            // in a column — even a 2-deep column already produces dh=510, which saturates
            // at any g_dt*bias product above ~0.5. Saturation isn't a rare edge case here,
            // it's the NORMAL case for anything but a single shallow puddle voxel. Clamping
            // every axis to the identical +-FILL_CAP means X/Y/Z all tie at the same
            // ceiling the moment more than one direction saturates — which collapses
            // gravity_bias's whole purpose right back to symmetric spreading, just
            // triggered by ordinary saturation instead of an oversized slider value.
            //
            // Real fix: give Y a LARGER clamp ceiling than X/Z, scaled by gravity_bias,
            // instead of sharing FILL_CAP. Scale (pass 1) applies ONE proportional factor s
            // to every lane's raw stored value — if Y's raw value can legitimately grow
            // past what X/Z are capped at, Y keeps a proportionally bigger share of the
            // outflow budget even when every axis is fully saturated, instead of losing
            // that distinction the instant they tie.
            float axis_cap = (axis == 1) ? float(FILL_CAP) * params.gravity_bias : float(FILL_CAP);

            // FIX (2026-07-02, "water never settles" bug): round(old_f * damp) has a fixed
            // point for damp=0.97 and small integer magnitudes -- round(n * 0.97) == n for
            // EVERY integer n from 1 to 16, meaning decay alone can never reach exactly 0;
            // a settled cell's residual flux gets stuck at a small nonzero value forever
            // and keeps being read (and applied, however trivially) by Scale/Transport
            // every tick, on already-flat water with no real pressure differential. This
            // was invisible while MIN_FLOW was 16 (the stuck range 1-16 was filtered out
            // entirely) -- lowering MIN_FLOW to 1 (fixing the low-fill-cell trap) unmasked
            // it across every settled body of water at once, which is why it got WORSE
            // right after that fix, not better. Symptom: water on flat ground perpetually
            // shuffling by tiny amounts, never settling, flooding the changelog with real
            // (not spurious) but pointless tick-after-tick fill churn.
            //
            // Fix: truncate the DECAY term toward zero instead of rounding it, guaranteeing
            // strict monotonic progress toward 0 every tick (int(1.0*0.97) = int(0.97) = 0,
            // fully resolved in one step; int(16.0*0.97) = int(15.52) = 15, still shrinking
            // every tick instead of sticking). The freshly-computed accel (genuinely new
            // forcing this tick, not decay) still gets normal rounding on the final sum --
            // only the carried-over persistence term needed the fix.
            float old_f = float(flux_buf.data[lane]);
            int decayed = int(old_f * params.damp);
            float new_f = float(decayed) + accel;
            new_f = clamp(new_f, -axis_cap, axis_cap);
            flux_buf.data[lane] = int(round(new_f));
        }
        return;
    }

    // === BuildRHS: provisional-gravity-flux divergence -> div_buf (params.pass == 2) ===
    // Pressure-projection port, Checkpoint 3. Only liquid cells get a div value (matches
    // the bench: air/solid cells are outside the pressure domain entirely). Vertical only
    // -- gravity has no X/Z component, so those faces never contribute (matches the
    // bench's "F*_x are all 0, so only vertical contributes").
    if (params.pass == 2) {
        if (my_page < 0) return;  // nowhere to store the RHS for this chunk
        bool my_is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        int div_slot = my_page * vpc + my_local;
        if (!my_is_liquid) {
            div_buf.data[div_slot] = 0.0;
            return;
        }
        float fy_up = proj_prov_fy(gpos, mat_id);                  // face p -> p+Y
        float fy_dn = proj_prov_fy(gpos - AXIS_DIR[1], mat_id);    // face p-Y -> p
        float d = fy_up - fy_dn;
        // Density correction: pulls a submerged, under-full cell toward full. MASKED OFF
        // at the free surface (no same-liquid cell directly above) -- port plan
        // non-negotiable #2. Without the mask this force-fills legitimately-partial
        // surface cells and breaks the rest/pressure-null state.
        if (proj_is_liquid_same(gpos + AXIS_DIR[1], mat_id)) {
            d += params.proj_STIFF * (255.0 - float(my_fill));
        }
        div_buf.data[div_slot] = d;
        return;
    }

    // === Pressure solve: one red-black Gauss-Seidel sweep (params.pass == 3 red / == 4
    // black) -> pressure_buf. Pressure-projection port, Checkpoint 4. Coloring is
    // (gx+gy+gz)&1 in WORLD voxel coordinates -- must be world, not local_pos, so the
    // checkerboard is consistent across chunk boundaries (a chunk's own size could be
    // even, which would otherwise flip the pattern chunk-to-chunk). Per the bench's
    // solve_pressure(): laplacian(P) = div, liquid-liquid faces couple normally,
    // liquid-air faces are Dirichlet P=0 (free surface), solid/off-grid/withheld-page
    // faces are Neumann (dropped) -- see proj_classify_neighbor() above.
    if (params.pass == 3 || params.pass == 4) {
        if (my_page < 0) return;
        bool my_is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        if (!my_is_liquid) return;  // pressure is only solved over the liquid domain

        int my_color = (gpos.x + gpos.y + gpos.z) & 1;
        int this_color = (params.pass == 3) ? 0 : 1;  // pass 3 = red (color 0), 4 = black (color 1)
        if (my_color != this_color) return;

        float s = 0.0;
        int k = 0;
        for (int axis = 0; axis < 3; axis++) {
            for (int dir = -1; dir <= 1; dir += 2) {
                ivec3 nb = gpos + AXIS_DIR[axis] * dir;
                int cls = proj_classify_neighbor(nb, mat_id, cs, vpc);
                if (cls == PROJ_NB_LIQUID) {
                    s += proj_pressure_at(nb, cs, vpc);
                    k += 1;
                } else if (cls == PROJ_NB_AIR) {
                    k += 1;  // Dirichlet P=0: contributes 0 to s, still counts toward k
                }
                // PROJ_NB_SEALED: dropped entirely, no k increment (Neumann).
            }
        }
        if (k == 0) return;  // sealed on every side -- nothing to solve against

        int p_slot = my_page * vpc + my_local;
        float div_here = div_buf.data[p_slot];
        float target = (s - div_here) / float(k);
        float p_old = pressure_buf.data[p_slot];
        pressure_buf.data[p_slot] = p_old + params.proj_OMEGA * (target - p_old);
        return;
    }

    // === Correct: F = u* - grad(P) -> flux_buf's owned faces (params.pass == 5) ===
    // Pressure-projection port, Checkpoint 5. Writes the SAME 3 owned lanes Accelerate
    // (pass 0) would have written -- Transport (pass 1) is completely unchanged, reading
    // flux_buf exactly as before regardless of which pass populated it this tick. Mirrors
    // Accelerate's exact face-participation rules (solid/air/different-liquid handling)
    // so the two passes gate identically; only the drive term differs (u*-grad(P) here
    // vs the head()-based dh there). No axis_cap clamp, matching the bench's
    // correct_flux() exactly -- an oversized request is bounded downstream by Transport's
    // existing s_out/s_in budgeting (compute_s_out/compute_s_in), same as any other pass.
    if (params.pass == 5) {
        if (my_page < 0) return;
        bool my_is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        bool my_is_air    = (mat_id == 0u);

        for (int axis = 0; axis < 3; axis++) {
            ivec3 nb = gpos + AXIS_DIR[axis];
            uint nv  = read_a(nb);
            uint nm  = nv & 0xFFu;
            int lane = my_page * vpc * 3 + my_local * 3 + axis;

            bool nb_is_liquid = (nm != 0u && material_sim.data[nm] == SIM_LIQUID);
            bool nb_is_air    = (nm == 0u);

            if ((!my_is_liquid && !my_is_air) || (!nb_is_liquid && !nb_is_air)) {
                flux_buf.data[lane] = 0;
                continue;
            }
            if (!my_is_liquid && !nb_is_liquid) {
                flux_buf.data[lane] = 0;
                continue;
            }
            if (my_is_liquid && nb_is_liquid && mat_id != nm) {
                flux_buf.data[lane] = 0;
                continue;
            }

            uint active_mat = my_is_liquid ? mat_id : nm;

            float p_here = proj_pressure_at(gpos, cs, vpc);
            float p_nb   = proj_pressure_at(nb, cs, vpc);
            float grad   = p_nb - p_here;

            float u_star = (axis == 1) ? proj_prov_fy(gpos, active_mat) : 0.0;
            float f = u_star - grad;

            flux_buf.data[lane] = int(round(f));
        }
        return;
    }

    // === LevelSurface: fractional lateral fill exchange, free surface only (params.pass ==
    // 6). Checkpoint 6 -- bench-validated fix for the flat-puddle design gap
    // (tools/fluid_prototypes/height_level_prototype.py, FLAT_PUDDLE_HANDOFF.md section 5b).
    // BuildRHS's divergence only ever sees VERTICAL stacking (provisional gravity flux +
    // the submerged density correction), so a single flat layer of uneven water has
    // div==0 everywhere -- with the free-surface P=0 Dirichlet BC also true at every cell,
    // the Poisson solve's unique solution is P==0 exactly, so the pressure solve can never
    // move it no matter how uneven it actually is. This pass sidesteps the solve entirely:
    // a small, conservative, surface-elevation-driven diffusion applied directly to the
    // surface layer, dispatched AFTER Transport (and after any projection passes) each
    // sub-step. Uses the same "compute both endpoints independently from read-only
    // pre-pass state" trick Transport's compute_s_out/compute_s_in already rely on for
    // race-free, lock-free parallelism -- no face ownership needed, conservation holds by
    // construction (see proj_level_classify's header comment). Writes via the changelog
    // like every other pass -- never touches voxels_a directly (single-writer discipline).
    if (params.pass == 6) {
        int self_cls = LEVEL_NB_NONE;
        bool my_is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        if (my_is_liquid) {
            self_cls = LEVEL_NB_SURFACE;
        } else if (mat_id == 0u) {
            self_cls = proj_is_sealed(gpos - AXIS_DIR[1]) ? LEVEL_NB_DRY : LEVEL_NB_NONE;
        }
        if (self_cls == LEVEL_NB_NONE) return;  // solid, or a non-fillable dry cell

        float self_fill = (self_cls == LEVEL_NB_SURFACE) ? float(my_fill) : 0.0;
        // Superseded the old per-cell "submerged" early-return (see proj_level_pressure_damping's
        // header comment): damping is now PER-PAIR, so a cell can legitimately defer toward one
        // neighbour (real pressure gradient) while still acting toward another (none) -- no
        // single self-only gate can express that, so there is no early-return here anymore.
        float p_self = proj_pressure_at(gpos, cs, vpc);
        int delta = 0;
        uint donor_mat = 0u;

        // Lateral only (X, Z) -- gravity/vertical stacking is BuildRHS's job, never this
        // pass's. AXIS_DIR[0] = X, AXIS_DIR[2] = Z; axis 1 (Y) is skipped entirely.
        for (int axis = 0; axis < 3; axis += 2) {
            for (int dir = -1; dir <= 1; dir += 2) {
                ivec3 nb = gpos + AXIS_DIR[axis] * dir;
                uint nb_mat;
                int nb_cls = proj_level_classify(nb, cs, vpc, nb_mat);
                if (nb_cls == LEVEL_NB_NONE) continue;
                if (self_cls == LEVEL_NB_DRY && nb_cls == LEVEL_NB_DRY) continue;  // two empties: nothing to exchange
                // Two different liquids never couple directly (mirrors Accelerate's rule) --
                // only meaningful when SELF is itself a liquid surface cell; a DRY self has
                // no material of its own yet, so it accepts whichever single liquid it finds.
                if (self_cls == LEVEL_NB_SURFACE && nb_cls == LEVEL_NB_SURFACE && nb_mat != mat_id) continue;

                float nb_fill = proj_level_fill_of(nb, nb_cls);
                float diff = self_fill - nb_fill;
                if (abs(diff) < params.proj_LEVEL_MIN) continue;

                // BUG (found 2026-07-06, in-engine test): summing diff*RATE per direction
                // UNNORMALIZED lets total outflow reach up to 4*RATE (all 4 lateral sides
                // active at once) in a single tick -- the Python bench never caught this
                // because it only ever tested a 1D row (exactly one active neighbor per
                // side). Confirmed in-engine: a single droplet on open flat ground with all
                // 4 sides free lost ~80% of its fill per tick (51->10->2->0, four
                // consecutive ~80% cuts) and the scripted U-tube's 3x3 cross-section arms
                // drained/scattered through the same mechanism. Fix: divide by a fixed
                // LEVEL_DEGREE (max lateral neighbor count) so total per-tick outflow is
                // capped at LEVEL_RATE regardless of how many sides are active -- same
                // symmetric pairwise math, correctly normalized.
                const float LEVEL_DEGREE = 4.0;
                // BUG (found 2026-07-06, in-engine test, "flickering at the floor"): a
                // boolean submerged gate re-evaluated fresh every tick flips this cell's
                // ENTIRE contribution on/off whenever the fill directly above hovers near
                // a threshold (e.g. a falling stream's settle noise) -- bench-confirmed
                // 199/200 ticks flipping. Fixed with a continuous damping factor.
                //
                // SUPERSEDED (2026-07-06, see BUG_LOG.md and proj_level_pressure_damping's
                // header comment): that continuous factor was still keyed off VERTICAL fill
                // above SELF alone, as a proxy for "does the pressure solve already own this
                // cell." A buried low-fill seam inside an otherwise-uniformly-stacked blob
                // broke the proxy: vertical fill above a 255-full cell said "submerged" even
                // though a genuinely open lateral neighbour existed right beside it --
                // confirmed in-engine (a fully-submerged cell with ~11-fill lateral
                // neighbours never transferred to them at all). Fixed by asking the ACTUAL
                // question directly, per pair: does the already-solved pressure field see a
                // real gradient here? A same-total-stacking buried seam reads as
                // |P_self - P_neighbour| ~ 0 (correctly acts); a genuine column-height
                // difference reads as a real |ΔP| (correctly defers to Correct's own push).
                // Bench-validated in tools/fluid_prototypes/level_surface_v3.py /
                // level_surface_v3_check.py (buried-seam + genuine-height-difference +
                // full regression suite, ALL PASSED).
                float p_nb = proj_pressure_at(nb, cs, vpc);
                float pair_damping = proj_level_pressure_damping(p_self, p_nb);

                // BUG (found 2026-07-06, in-engine test: real, sustained mass loss on any
                // puddle with cells that have 2+ active lateral neighbours -- confirmed via
                // debug_conservation_check showing near-constant "fill lost" every tick,
                // never balancing out, unlike ordinary +-1 rounding noise). The original
                // version summed every active pair's contribution into a single float
                // (delta_f) and rounded ONCE at the end. Conservation requires each PAIR's
                // contribution to cancel exactly between its two cells -- but round(a+b) !=
                // round(a) + round(b) in general, so once a cell has more than one active
                // neighbour, its aggregate-then-rounded total has no guaranteed relationship
                // to the sum of what its individual neighbours independently rounded on
                // their own side. That mismatch is a real, structural leak, not noise -- and
                // it explains why the loss was consistently one-directional rather than
                // randomly distributed. The Python bench never caught this because it models
                // fill as continuous floats and never introduces an integer rounding step at
                // all. Fix: round PER PAIR, immediately, before summing. round(x) and
                // round(-x) are exact negatives of each other, so two cells independently
                // rounding the same pair's amount always get exactly opposite integers --
                // pairwise cancellation holds regardless of how many other neighbours either
                // cell has, because summing already-integer amounts preserves exact equality
                // (unlike summing floats and rounding the aggregate). Uses roundEven(), not
                // round() -- GLSL's round() has IMPLEMENTATION-DEFINED tie-breaking at exact
                // .5 boundaries, not guaranteed symmetric under negation on all hardware;
                // roundEven() is spec-guaranteed round(x) == -round(-x), which this fix's
                // entire cancellation guarantee depends on.
                int pair_delta = int(roundEven(diff * (params.proj_LEVEL_RATE / LEVEL_DEGREE) * pair_damping));
                delta -= pair_delta;  // give toward the lower side, take from the higher side
                if (pair_delta != 0 && self_cls == LEVEL_NB_DRY && nb_cls == LEVEL_NB_SURFACE) {
                    donor_mat = nb_mat;
                }
            }
        }
        if (delta == 0) return;

        int old_fill = int(self_cls == LEVEL_NB_SURFACE ? my_fill : 0u);
        int new_fill = clamp(old_fill + delta, 0, 255);
        if (new_fill == old_fill) return;

        uint new_voxel;
        if (new_fill == 0) {
            new_voxel = 0u;
        } else if (self_cls == LEVEL_NB_DRY) {
            if (donor_mat == 0u) return;  // no valid donor found this tick -- spurious, skip (mirrors Transport)
            new_voxel = donor_mat | (uint(new_fill) << 8u);
        } else {
            new_voxel = (my_voxel & 0xFFFF00FFu) | (uint(new_fill) << 8u);
        }

        int applied = new_fill - old_fill;
        atomicAdd(conservation.delta, applied);
        if (applied > gain_tracker.amount) {
            gain_tracker.amount   = applied;
            gain_tracker.flat_idx = my_flat;
        }

        uint log_slot = atomicAdd(changelog.count, 1u);
        if (log_slot < MAX_CHANGELOG) {
            changelog.entries[log_slot * 2u]     = uint(my_flat);
            changelog.entries[log_slot * 2u + 1u] = new_voxel;
        }
        if (abs(applied) >= params.settle_threshold) {
            mark_dirty(my_flat, vpc);
        }
        return;
    }

    // === Transport: fill' = fill − owned faces + neighbour-owned faces (params.pass == 1) ===
    // fill'(p) = fill(p) − fx(p) − fy(p) − fz(p) + fx(p−X) + fy(p−Y) + fz(p−Z), with every
    // term additionally scaled by s_out(true donor) * s_in(true receiver) — see the file
    // header and compute_s_out()/compute_s_in() above for why this is conservation-safe
    // without any of the old Scale-Outflow/Scale-Inflow passes or their rewritten lanes.
    if (params.pass == 1) {
        float my_s_out = compute_s_out(gpos, cs, vpc);
        float my_s_in  = compute_s_in(gpos, cs, vpc);

        float delta_f = 0.0;
        for (int axis = 0; axis < 3; axis++) {
            // My owned face (+axis direction).
            if (my_page >= 0) {
                int v = eff_flux(flux_buf.data[my_page * vpc * 3 + my_local * 3 + axis]);
                if (v > 0) {
                    // I'm donor, my +axis neighbour is receiver.
                    ivec3 receiver = gpos + AXIS_DIR[axis];
                    delta_f -= float(v) * my_s_out * compute_s_in(receiver, cs, vpc);
                } else if (v < 0) {
                    // My +axis neighbour is donor, I'm receiver.
                    ivec3 donor = gpos + AXIS_DIR[axis];
                    delta_f -= float(v) * compute_s_out(donor, cs, vpc) * my_s_in;
                }
            }
            // Neighbour-owned face at my -axis (that neighbour's +axis face, pointing at me).
            ivec3 nb = gpos - AXIS_DIR[axis];
            int nlane = flux_lane(nb, axis);
            if (nlane >= 0) {
                int w = eff_flux(flux_buf.data[nlane]);
                if (w > 0) {
                    // My -axis neighbour is donor, I'm receiver.
                    delta_f += float(w) * compute_s_out(nb, cs, vpc) * my_s_in;
                } else if (w < 0) {
                    // I'm donor (through a face my -axis neighbour owns), they're receiver.
                    delta_f += float(w) * my_s_out * compute_s_in(nb, cs, vpc);
                }
            }
        }
        int delta = int(round(delta_f));
        if (delta == 0) return;

        bool is_liquid = (mat_id != 0u && material_sim.data[mat_id] == SIM_LIQUID);
        bool is_air    = (mat_id == 0u);
        if (!is_liquid && !is_air) return;  // solid: transport never touches it

        if (is_air && delta <= 0) return;              // air with net outflow: nothing to move
        if (is_liquid && my_fill == 0u && delta <= 0) return;

        // Air receiving inbound flux materializes as liquid — scan all 6 neighbours for
        // the donor's material (mirrors the same scan proven correct in Phase 7d's Pass 1;
        // the source design's pseudocode omits this — see ARCHITECTURE.md Step 6 note).
        uint fill_mat = mat_id;
        if (is_air) {
            ivec3 scan[6];
            scan[0] = gpos + AXIS_DIR[0]; scan[1] = gpos - AXIS_DIR[0];
            scan[2] = gpos + AXIS_DIR[1]; scan[3] = gpos - AXIS_DIR[1];
            scan[4] = gpos + AXIS_DIR[2]; scan[5] = gpos - AXIS_DIR[2];
            for (int i = 0; i < 6; i++) {
                uint nv = read_a(scan[i]);
                uint nm = nv & 0xFFu;
                if (nm != 0u && material_sim.data[nm] == SIM_LIQUID) {
                    fill_mat = nm;
                    break;
                }
            }
            if (fill_mat == 0u) return;  // no liquid neighbour found — spurious delta, skip
        }

        int old_fill = int(is_liquid ? my_fill : 0u);
        int new_fill = clamp(old_fill + delta, 0, 255);
        if (new_fill == old_fill) return;

        // No receiver-side floor needed (removed 2026-07-02, see MIN_FLOW/eff_flux above).
        // delta is built entirely from eff_flux() reads, so any single-donor contribution
        // to it already has magnitude >= MIN_FLOW — a materializing cell's new_fill is a
        // real, meaningful transfer by construction, not a trace amount that needs a
        // second gate to filter out. (Narrow edge case: multiple donors with opposing
        // signs, each individually >= MIN_FLOW, could in principle sum to a small net
        // delta — e.g. +17 and -16 — producing a small materialized fill. Rare, requires
        // simultaneous opposing flows from different neighbours, and self-limiting rather
        // than runaway; not worth a second check for.)

        uint new_voxel;
        if (new_fill == 0) {
            new_voxel = 0u;  // destroyed
        } else if (is_air) {
            new_voxel = fill_mat | (uint(new_fill) << 8u);
        } else {
            new_voxel = (my_voxel & 0xFFFF00FFu) | (uint(new_fill) << 8u);
        }

        // Automatic conservation check: record the REAL applied change (post-clamp), not
        // the raw delta — clamping at the 0/255 boundary is itself a legitimate, if rare,
        // source of gain/loss (e.g. multiple donors overfilling a cell past 255 loses the
        // excess here), and that's exactly the kind of thing this check exists to catch.
        int applied = new_fill - old_fill;
        atomicAdd(conservation.delta, applied);
        if (applied > gain_tracker.amount) {
            gain_tracker.amount   = applied;
            gain_tracker.flat_idx = my_flat;
        }

        uint log_slot = atomicAdd(changelog.count, 1u);
        if (log_slot < MAX_CHANGELOG) {
            changelog.entries[log_slot * 2u]     = uint(my_flat);
            changelog.entries[log_slot * 2u + 1u] = new_voxel;
        }

        // Voxel sleeping (2026-07-03) — mark_dirty() feeds the CPU-side idle-guard that
        // decides whether a chunk stays in _active_chunks for next tick's dispatch. A
        // large, mostly-settled body of water can have long-lived, slowly-decaying
        // sloshing (intentional — flux_buf persists across ticks specifically so waves
        // don't instantly damp) that keeps making tiny (1-3 unit) but genuinely nonzero
        // transfers forever, so the chunk's dirty bit never goes fully quiet and it never
        // sleeps, even once visually and physically settled. settle_threshold is a
        // SEPARATE, coarser floor purely for this scheduling decision — every real
        // transfer, however small, still gets written to voxels_a above regardless of
        // this check (no new conservation risk, MIN_FLOW/eff_flux already own
        // correctness); this only controls whether the CHUNK keeps getting re-dispatched.
        // Once idle 4 ticks under this softer rule, FluidSimulation._free_flux_page()
        // evicts AND zeroes the chunk's flux page — sleeping and clearing residual
        // momentum happen together, so a chunk that wakes later (new water added nearby)
        // starts from a clean zero instead of replaying stale, possibly many-tick-old
        // flux values.
        if (abs(applied) >= params.settle_threshold) {
            mark_dirty(my_flat, vpc);
        }
    }
}
