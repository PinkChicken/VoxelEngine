#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Applies a changelog directly to voxel_buf_a on the GPU.
// Eliminates the CPU chunk re-upload step from apply_changelog().
// Dispatched with ceil(count / 64) workgroups after each simulation pass.

layout(set = 0, binding = 0, std430) buffer VoxelBufA {
    uint data[];
} voxels_a;

layout(set = 0, binding = 1, std430) readonly buffer Changelog {
    uint count;
    uint entries[];  // interleaved: flat_idx, new_value, flat_idx, new_value ...
} changelog;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= changelog.count) return;
    voxels_a.data[changelog.entries[i * 2u]] = changelog.entries[i * 2u + 1u];
}
