#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Applies a changelog directly to voxel_buf_a on the GPU.
// Eliminates the CPU chunk re-upload step from apply_changelog().
// Dispatched with ceil(count / 64) workgroups after each simulation pass.

layout(set = 0, binding = 0, std430) buffer VoxelBufA {
    uint data[];
} voxels_a;

layout(set = 0, binding = 1, std430) readonly buffer Changelog {
    uint count;
    uint entries[];  // interleaved: flat_idx, new_value, flat_idx, new_value ...
} changelog;

// Voxels are packed 4 per u32 (1 byte each = material id): `flat >> 2` picks the word,
// `(flat & 3) << 3` the byte within it. Writing one byte means clearing and setting only
// that byte's bits — two threads touching DIFFERENT bytes of the same word commute, so the
// two atomics are safe without a lock.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= changelog.count) return;
    uint vox_idx = changelog.entries[i * 2u];
    uint mat  = changelog.entries[i * 2u + 1u] & 0xFFu;
    uint wi = vox_idx >> 2u;
    uint sh = (vox_idx & 3u) << 3u;
    atomicAnd(voxels_a.data[wi], ~(0xFFu << sh));
    atomicOr(voxels_a.data[wi], mat << sh);
}
