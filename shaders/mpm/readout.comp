#version 450
layout(local_size_x = 64) in;

// MPM voxel readout — writes the current per-node material/mass state back into the REAL
// voxel world (via the shared changelog + patch_apply.comp, the same safe multi-writer path
// GranularSimulation/FluidSimulation already use — NOT a direct _voxel_buf_a write, which
// would risk racing another writer's own pending changelog within the same tick). Dispatched
// once per game tick (after a batch of physics substeps), not per substep — voxel visibility
// only needs to track the SETTLED state, not every intermediate substep.
//
// The MPM grid IS the voxel grid (brief §15-18, no separate render resolution) — g_mass/
// g_mass_mat are already computed by p2g.comp every substep; this pass is a per-node
// argmax+threshold reduce over already-computed data, not a second particle scatter.
//
// CRITICAL GUARD: never writes over a STATIC-material voxel (rock/glass) — MPM has no
// particle representation for those yet (brief §37, deferred), so a node landing on real
// terrain must leave it alone. Reads the current voxel first and bails if its material's
// mpm_model is STATIC, using the exact same MaterialDB table grid_op.comp's no-slip check
// already reads.

layout(set = 0, binding = 0, std430) readonly buffer Params {
	// Rectangular region grid (2026-08-13) — was a single cube edge `n_grid`. Must match
	// MPMSimulation._upload_region_params() byte for byte.
	int dim_x; int dim_y; int dim_z; int n_particles;
	float dt; float dx; float inv_dx; float gravity;
	float p_vol; float fp_scale; int bound; int num_blocks;
} P;
layout(set = 0, binding = 9, std430) readonly buffer GMass { int data[]; } g_mass;
layout(set = 0, binding = 12, std430) readonly buffer GMassMat { int data[]; } g_mass_mat;
layout(set = 0, binding = 13, std430) readonly buffer MatTable { uint data[]; } mat_table;
layout(set = 0, binding = 14, std430) readonly buffer VoxelParams {
	int chunk_size;
	int grid_min_x; int grid_min_y; int grid_min_z;
	int grid_span_x; int grid_span_y; int grid_span_z;
	int origin_x; int origin_y; int origin_z;
	int voxel_world_valid;
	int pad1;
} VP;
layout(set = 0, binding = 15, std430) readonly buffer VoxelBufA { uint data[]; } voxels_a;
layout(set = 0, binding = 16, std430) readonly buffer ChunkTable { int data[]; } chunk_table;
layout(set = 0, binding = 17, std430) buffer Changelog {
	uint count;
	uint entries[];  // interleaved: flat_idx, new_value, flat_idx, new_value ...
} changelog;
// 1 bit per chunk SLOT (matches GranularSimulation's DIRTY_BUF_BYTES=64 convention — 512
// slots' worth is far more than one MPM window's local footprint ever touches). Cleared by
// MPMSimulation.readout() before this dispatch, downloaded after for diagnostics/future
// chunks_committed wiring — NOT emitted yet, see mpm_simulation.gd's readout() for why.
layout(set = 0, binding = 18, std430) buffer DirtyChunks { uint data[]; } dirty_chunks;
// FACE TOUCH mask (2026-08-13) — 6 bits, one per region face. Set when a node lying ON that face
// plane produced an actual change, i.e. material is genuinely at the edge of the simulated domain
// and wants to leave. Region growth keys off this. It replaced a chunk-granular test ("any face
// CHUNK changed"), which was far too coarse: a face chunk is 32 voxels deep, so a body spanning
// the outer chunks while sitting 20 voxels inside them triggered growth on all six faces and
// inflated a 2x2x2 region into 3x3x3 — 884,736 nodes for a 5,575-particle body, measured at
// 4.0 ms/tick with 159 grid nodes per particle.
layout(set = 0, binding = 19, std430) buffer FaceMask { uint data[]; } face_mask;
// PER-CHUNK OCCUPANCY (2026-08-13) — 1 bit per chunk of the region grid, set when ANY node in that
// chunk holds mass. Region release keys off this so it can never drop a chunk that still contains
// material. The previous release test was "this chunk produced no readout change for 30 ticks",
// which is true of any chunk holding RESTING water — the most common state there is. The region
// shrank over settled water, and _copy_particles_shifted() then killed the particles left outside,
// freezing the water in place: an intact sphere hanging in mid-air, and a stretched column where
// only part of the body survived. That is the reported "it just isn't going down".
layout(set = 0, binding = 20, std430) buffer Occupancy { uint data[]; } occupancy;
layout(set = 0, binding = 23, std430) readonly buffer BlockList { int data[]; } block_list;

const uint NMAT = 8u;
const uint MODEL_STATIC = 1u;
const uint MAT_STRIDE_U32 = 8u;
const uint MAX_CHANGELOG = 524288u;  // must match WorldOrchestrator.MAX_CHANGELOG_ENTRIES

uint mat_model(uint mat_id) { return mat_table.data[mat_id * MAT_STRIDE_U32 + 0u]; }

// Ported 1:1 from shaders/granular_sim.comp's world_to_flat() (same chunk_table scheme) —
// duplicated here rather than shared across files, matching this project's existing
// convention (grid_op.comp already duplicates it rather than using a #include, which GLSL
// compute shaders in this codebase don't use).
int world_to_flat(ivec3 gpos, out int vpc) {
	int cs = VP.chunk_size;
	vpc = cs * cs * cs;
	ivec3 cp = ivec3(floor(vec3(gpos) / float(cs)));
	ivec3 lcp = cp - ivec3(VP.grid_min_x, VP.grid_min_y, VP.grid_min_z);
	if (lcp.x < 0 || lcp.x >= VP.grid_span_x ||
		lcp.y < 0 || lcp.y >= VP.grid_span_y ||
		lcp.z < 0 || lcp.z >= VP.grid_span_z) return -1;
	int tbl = lcp.z * VP.grid_span_x * VP.grid_span_y + lcp.y * VP.grid_span_x + lcp.x;
	int slot = chunk_table.data[tbl];
	if (slot < 0) return -1;
	ivec3 lp = gpos - cp * cs;
	return slot * vpc + lp.z * cs * cs + lp.y * cs + lp.x;
}

void mark_dirty(int flat_idx, int vpc) {
	int chunk_slot = flat_idx / vpc;
	atomicOr(dirty_chunks.data[uint(chunk_slot) >> 5u], 1u << (uint(chunk_slot) & 31u));
}

void main() {
	if (VP.voxel_world_valid == 0) return;
	uint idx = gl_GlobalInvocationID.x;
	uint G = uint(P.num_blocks) * 32768u;
	if (idx >= G) return;

	// S1 Phase 1 — block-major decode: recover the node's region-local coordinate from the flat
	// invocation index (inverse of node_index() in p2g/g2p). ALL blocks allocated → pure
	// re-linearisation; Phase 2 makes the block slot a sparse-table lookup.
	int lx = int(idx & 31u);
	int ly = int((idx >> 5u) & 31u);
	int lz = int((idx >> 10u) & 31u);
	int slot = int(idx >> 15u);
	int nb_x = P.dim_x >> 5;
	int nb_y = P.dim_y >> 5;
	int dense = block_list.data[slot];
	int bx = dense % nb_x;
	int by = (dense / nb_x) % nb_y;
	int bz = dense / (nb_x * nb_y);
	int ix = bx * 32 + lx;
	int iy = by * 32 + ly;
	int iz = bz * 32 + lz;
	// Region origin + local node = world voxel. world_to_flat() below then resolves which
	// CHUNK that voxel belongs to, so a node in chunk N+1 writes into chunk N+1's slot —
	// the mapping across region-internal chunk boundaries is already generic.
	ivec3 world_voxel = ivec3(VP.origin_x, VP.origin_y, VP.origin_z) + ivec3(ix, iy, iz);

	int vpc;
	int flat_idx = world_to_flat(world_voxel, vpc);
	if (flat_idx < 0) return;

	uint cur_voxel = voxels_a.data[flat_idx];
	uint cur_mat = cur_voxel & 0xFFu;
	if (cur_mat != 0u && mat_model(cur_mat) == MODEL_STATIC) return;  // never touch real terrain

	float mass = float(g_mass.data[idx]) / P.fp_scale;
	// Threshold well below a single settled particle's contribution at typical density —
	// distinguishes "genuinely empty" from "one particle's kernel tail reaching this node."
	const float MASS_THRESHOLD = 1e-6;

	// FACE PRESENCE (2026-08-13, second attempt). Set the face bits from MASS PRESENCE at a
	// boundary plane, NOT from having written a change there.
	//
	// Keying on writes was wrong in a way that produced the reported symptom exactly: water
	// falling onto the floor of the region comes to REST there, and resting material produces no
	// write (nothing changed, and the fill deadband suppresses the churn) — so no face bit was
	// ever set, the region never grew downward, and the water sat on an invisible floor forever.
	// Measured: 8 minutes of simulation with the region 1 chunk tall in Y and growing 2x2 -> 5x5
	// in X/Z, i.e. it grew in every direction except the one gravity needed.
	//
	// Presence is self-limiting: after growing, that material is interior, the new plane is empty,
	// and the bit clears.
	if (mass >= MASS_THRESHOLD) {
		// Occupancy only. FACE detection moved to grid_op.comp, where velocity is available and
		// a face can be judged by whether material is actively being PUSHED into it rather than
		// merely resting against it (see the FACE PUSH block there).
		int cs = VP.chunk_size;
		int dcx = P.dim_x / cs;
		int dcy = P.dim_y / cs;
		int cidx = (iz / cs) * dcx * dcy + (iy / cs) * dcx + (ix / cs);
		atomicOr(occupancy.data[uint(cidx) >> 5u], 1u << (uint(cidx) & 31u));
	}

	uint new_voxel;
	if (mass < MASS_THRESHOLD) {
		if (cur_mat == 0u) return;  // already air, nothing to change — don't spam the changelog
		new_voxel = 0u;
	} else {
		uint best_mat = 0u;
		int best_mass = 0;
		for (uint m = 0u; m < NMAT; m++) {
			int mm = g_mass_mat.data[idx * NMAT + m];
			if (mm > best_mass) { best_mass = mm; best_mat = m; }
		}
		if (best_mass == 0) return;  // shouldn't happen given mass>=threshold, but stay safe
		// fill calibration is approximate (brief §37 — this step proves the mechanism writes
		// correctly, not a tuned visual density; REFERENCE_MASS is a starting point, not a
		// measured constant). 1..255, never 0 — an occupied cell must never render as air.
		const float REFERENCE_MASS = 4.0;  // ~settled single-particle mass at this port's p_vol/density scale
		float fill_f = clamp(mass / REFERENCE_MASS, 0.0, 1.0) * 255.0;
		uint fill = uint(clamp(fill_f, 1.0, 255.0));
		// FILL DEADBAND (2026-08-13). Particles jittering by a fraction of a voxel produce a
		// slightly different mass, hence a slightly different quantised fill, EVERY tick. Each
		// of those writes registers as a change, which is exactly the signal the region's idle
		// timer uses — so a settled pool could sit there visibly motionless and still never
		// sleep. Suppressing sub-threshold fill churn lets the timer actually reach zero.
		// (Deliberately AFTER `fill` is computed — referencing it earlier is a GLSL parse error,
		// which is exactly how this first shipped and why MPM refused to bind.)
		const int FILL_DEADBAND = 2;
		uint cur_fill = (cur_voxel >> 8u) & 0xFFu;
		if (best_mat == cur_mat && abs(int(fill) - int(cur_fill)) <= FILL_DEADBAND) return;
		new_voxel = best_mat | (fill << 8u);
	}

	if (new_voxel == cur_voxel) return;

	uint log_slot = atomicAdd(changelog.count, 1u);
	if (log_slot < MAX_CHANGELOG) {
		changelog.entries[log_slot * 2u]      = uint(flat_idx);
		changelog.entries[log_slot * 2u + 1u] = new_voxel;
		mark_dirty(flat_idx, vpc);
	}
}
